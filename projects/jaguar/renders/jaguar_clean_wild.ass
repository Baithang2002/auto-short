Dialogue: 0,0:00:00.00,0:01:22.00,Header,,0,0,0,,{\\c&H0000E6FF&}RARE ENCOUNTER{\\c&H00FFFFFF&}  |  MOTHER JAGUAR & CUB
Dialogue: 0,0:00:00.00,0:00:03.20,Subtitle,,0,0,0,,{\\c&H0000E6FF&}JAGUAR CUBS{\\c&H00FFFFFF&} STICK WITH THEIR MOTHERS\NFOR THE FIRST FEW YEARS.
Dialogue: 0,0:00:10.30,0:00:14.72,Subtitle,,0,0,0,,SHE WEANED HIM {\\c&H0000E6FF&}SIX MONTHS AGO{\\c&H00FFFFFF&},\NBUT HE STILL COUNTS ON HER...
Dialogue: 0,0:00:14.72,0:00:18.20,Subtitle,,0,0,0,,TO {\\c&H0000E6FF&}CATCH HIS DINNER{\\c&H00FFFFFF&}\NAND KEEP HIM SAFE.
Dialogue: 0,0:00:29.04,0:00:34.02,Subtitle,,0,0,0,,HE'S GOING TO BE {\\c&H0000E6FF&}BIGGER THAN SHE IS{\\c&H00FFFFFF&},\NBUT INSIDE, HE'S STILL ALL CUB.
Dialogue: 0,0:00:50.34,0:00:55.52,Subtitle,,0,0,0,,THEY ARE {\\c&H0000E6FF&}15 METERS AWAY{\\c&H00FFFFFF&} — LESS THAN 50 FEET,\NAND THEY'RE SO RELAXED...
Dialogue: 0,0:00:55.52,0:00:58.72,Subtitle,,0,0,0,,THAT I'VE MANAGED TO ACTUALLY\N{\\c&H0000E6FF&}GET OUT OF THE BOAT{\\c&H00FFFFFF&} AND SIT HERE.
Dialogue: 0,0:01:03.38,0:01:08.86,Subtitle,,0,0,0,,THERE'S THE {\\c&H0000E6FF&}FEMALE{\\c&H00FFFFFF&} THERE,\nAND THERE'S THE {\\c&H0000E6FF&}CUB{\\c&H00FFFFFF&} JUST OVER THERE.
Dialogue: 0,0:01:15.20,0:01:21.98,Subtitle,,0,0,0,,JUST SO GRATEFUL FOR A WINDOW\nINTO THE {\\c&H0000E6FF&}SECRET LIFE OF THE CUBS{\\c&H00FFFFFF&}.
