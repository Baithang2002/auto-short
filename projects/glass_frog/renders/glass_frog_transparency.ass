Dialogue: 0,0:00:00.00,9:59:59.00,Header,,0,0,0,,{\\c&H0000E6FF&}THE INVISIBLE FROG{\\c&H00FFFFFF&}  |  GLASS FROG
Dialogue: 0,0:00:00.50,0:00:09.64,Subtitle,,0,0,0,,IN THE TROPICAL RAINFORESTS,\nTHE DENSE GREENERY IS A {\\c&H0000E6FF&}SAFE HAVEN{\\c&H00FFFFFF&}.
Dialogue: 0,0:00:09.64,0:00:14.52,Subtitle,,0,0,0,,LIFE CAN {\\c&H0000E6FF&}HIDE IN PLAIN SIGHT{\\c&H00FFFFFF&}.
Dialogue: 0,0:00:14.52,0:00:19.80,Subtitle,,0,0,0,,FOR THIS GLASS FROG,\nCAMOUFLAGE IS {\\c&H0000E6FF&}EFFORTLESS{\\c&H00FFFFFF&}.
Dialogue: 0,0:00:19.80,0:00:23.32,Subtitle,,0,0,0,,IT HAS MASTERED THE\n{\\c&H0000E6FF&}ART OF INVISIBILITY{\\c&H00FFFFFF&}.
Dialogue: 0,0:00:23.32,0:00:29.28,Subtitle,,0,0,0,,THEY AREN'T NAMED FOR\nTHEIR {\\c&H0000E6FF&}FRAGILITY{\\c&H00FFFFFF&}...
Dialogue: 0,0:00:29.28,0:00:36.12,Subtitle,,0,0,0,,THEIR BONES, INTESTINES & {\\c&H0000E6FF&}BEATING HEARTS{\\c&H00FFFFFF&}\nCAN BE SEEN THROUGH THEIR SKIN.
Dialogue: 0,0:00:39.16,0:00:45.60,Subtitle,,0,0,0,,THEY'RE TRANSLUCENT WITH THE SKIN\nON THEIR BACKS {\\c&H0000E6FF&}VIVID GREEN{\\c&H00FFFFFF&}.
Dialogue: 0,0:00:45.60,0:00:52.60,Subtitle,,0,0,0,,THIS ALLOWS THEM TO {\\c&H0000E6FF&}BRIGHTEN OR DARKEN{\\c&H00FFFFFF&}\nDEPENDING ON THE BACKGROUND.
Dialogue: 0,0:00:52.60,0:01:00.00,Subtitle,,0,0,0,,THEIR SEE-THROUGH LEGS {\\c&H0000E6FF&}BREAK UP OUTLINES{\\c&H00FFFFFF&}\nBLENDING THEM SMOOTHLY INTO LEAVES.
Dialogue: 0,0:01:00.00,0:01:13.00,Subtitle,,0,0,0,,THIS UNIQUE PHENOMENON IS KNOWN AS\n{\\c&H0000E6FF&}EDGE DIFFUSION{\\c&H00FFFFFF&}.
Dialogue: 0,0:01:13.00,0:01:25.00,Subtitle,,0,0,0,,IN THE GAME OF HIDE AND SEEK,\nTHEY {\\c&H0000E6FF&}OUTWIT EVERY PREDATOR{\\c&H00FFFFFF&}.
Dialogue: 0,0:01:25.00,0:01:38.00,Subtitle,,0,0,0,,A MASTERCLASS IN {\\c&H0000E6FF&}STEALTH AND SURVIVAL{\\c&H00FFFFFF&}\nIN THE DENSE RAINFOREST.
